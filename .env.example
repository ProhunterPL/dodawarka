# Apilo REST API (https://developer.apilo.com/api/)
APILO_HOST=https://twoja-instancja.apilo.com
APILO_CLIENT_ID=
APILO_CLIENT_SECRET=
APILO_AUTHORIZATION_CODE=

# Uzupełniane automatycznie po pierwszej autoryzacji (opcjonalnie ręcznie)
APILO_REFRESH_TOKEN=

# Gdy true — domyślny dry-run tylko gdy UI nie poda jawnej wartości
APILO_DRY_RUN=false

# OpenAI — asystent uzupełniania braków (opis, kategoria, błędy Apilo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AWS S3 — upload zdjęć produktów (publiczne URL-e dla Apilo)
AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcjonalnie: CloudFront lub własna domena zamiast domyślnego URL bucketa
AWS_S3_PUBLIC_BASE_URL=

# Pula EAN-13 — opcjonalny start gdy brak numerów w kody_ean/*.xlsx (np. 5906058689547)
# EAN_POOL_START=5906058689547
